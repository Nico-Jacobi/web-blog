# ──────────────────────────────────────────────────────────────────────
# Required in production — server refuses to start without JWT_SECRET.
# ──────────────────────────────────────────────────────────────────────
# Long random string used to sign JWTs. Rotating it logs everyone out.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Server / paths
# ──────────────────────────────────────────────────────────────────────
PORT=3000

# Where SQLite + per-blog files live. Survives restarts; back this up.
STORAGE_DIR=./storage

# Optional explicit path; defaults to <STORAGE_DIR>/app.db
# DB_PATH=./storage/app.db

# Built React site to serve as the public-facing frontend. The server
# falls back to index.html for any non-API path so /<blogSlug>/stop/<x>
# deep links work on hard reload. Leave the default if you build the
# website with `cd website && npm run build`.
WEB_DIR=./website/dist

# ──────────────────────────────────────────────────────────────────────
# JWT TTLs (seconds). Defaults: 15 min access, 30 days refresh.
# ──────────────────────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=2592000

# ──────────────────────────────────────────────────────────────────────
# Web Push (optional). Without these, push is silently disabled.
# Generate with:  npx web-push generate-vapid-keys
# ──────────────────────────────────────────────────────────────────────
VAPID_CONTACT=admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────
# argon2id tuning (optional). Defaults are sane for most servers.
# ──────────────────────────────────────────────────────────────────────
# ARGON2_MEMORY_KB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
